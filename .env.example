# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vnmacro
POSTGRES_USER=vnmacro
POSTGRES_PASSWORD=change-me

# LLM provider (OpenAI). The local embedding model is pinned in src/vnmacro/config.py.
OPENAI_API_KEY=
OPENAI_MODEL=
