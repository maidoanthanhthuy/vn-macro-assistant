# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vnmacro
POSTGRES_USER=vnmacro
POSTGRES_PASSWORD=change-me

# LLM provider (OpenAI). The local embedding model is pinned in src/vnmacro/config.py.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: base URL of another OpenAI-compatible provider (empty = OpenAI)
OPENAI_BASE_URL=

# Read-only database role for Text-to-SQL (sql/roles.sql, python -m vnmacro.roles apply)
DB_READER_PASSWORD=
DATABASE_URL_READER=

# Insert-only database role for the query log (sql/roles.sql, python -m vnmacro.roles apply)
DB_LOGGER_PASSWORD=
DATABASE_URL_LOGGER=

# Question embeddings: local (needs requirements-embed.txt / torch) or openai (API).
# The chosen backend's chunk vectors must be in rag.chunk_embeddings
# (python -m vnmacro.rag.embed --backend openai).
EMBEDDING_BACKEND=local
